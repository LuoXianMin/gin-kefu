# ============================================================
# 生产/部署敏感配置模板 —— 复制为根目录 .env 后填写真实值
#   cp .env.example .env
# .env 已被 gitignore，切勿提交；compose 启动时自动加载同目录 .env
# 消费方：docker-compose.yml 插值 + server/core/env_override.go(os.Getenv)
# ============================================================

# --- SSO 免密进入(客服 h5 ?user= 参数) ---
# AES-256-GCM 共享密钥，程序读 env 名由 config yaml 的 sso.aes-key-env 指定
# 留空 = SSO 接口自动拒绝服务；商户侧对接规范见 docs/cs/sso-php.md
GVA_CS_SSO_KEY=

# --- 短信通道(sms.provider=http 时必填, log 模式留空) ---
# 程序读的 env 名由 sms.access-key-env / secret-key-env 指定(默认即下面两个)
GVA_SMS_AK=
GVA_SMS_SK=
# 短信环境依赖配置(非空则覆盖 yaml sms 段同名项，见 server/core/env_override.go)
GVA_SMS_PROVIDER=           # log | http | aliyun；log=只写日志不真发(开发默认), aliyun=真发阿里云短信, http=自定义 HMAC 网关
GVA_SMS_ENDPOINT=           # http 模式必填网关地址; aliyun 模式留空则用 https://dysmsapi.aliyuncs.com
GVA_SMS_SIGN_NAME=          # 短信签名(如 阿里云签名名)
GVA_SMS_TEMPLATE_CODE=      # 短信模板 Code(如 SMS_123456)
GVA_SMS_TEMPLATE_PARAM_KEY= # aliyun 模板正文里的验证码变量名(${code} 则填 code), 留空=code
GVA_SMS_REGION=             # aliyun 短信地域, 留空=cn-hangzhou
GVA_SMS_DEV_RETURN_CODE=    # 生产必设 false！留空用 yaml 值(开发态为 true=验证码直接回显)

# --- JWT 签名密钥 ---
# 非空则覆盖 config yaml 的 jwt.signing-key；更换后所有令牌失效(全员重登)
# 生成示例: openssl rand -hex 32
GVA_JWT_SIGNING_KEY=

# --- 主数据库(按 system.db-type 生效, 与 pgsql 容器凭据同源) ---
GVA_DB_USERNAME=gva
GVA_DB_PASSWORD=gva123
GVA_DB_NAME=gva

# --- Redis(非空则 redis 容器开启 requirepass + 程序侧同步生效) ---
GVA_REDIS_PASSWORD=

# --- MongoDB 鉴权(两项均非空才启用；仅对全新数据卷的初始化生效) ---
GVA_MONGO_USERNAME=
GVA_MONGO_PASSWORD=

# --- OSS 对象存储(按 system.oss-type 覆盖对应段的 AK/SK; local 模式留空) ---
GVA_OSS_ACCESS_KEY_ID=
GVA_OSS_ACCESS_KEY_SECRET=

# --- 环境类型与策略开关(生产/开发行为差异，非敏感但同样集中在此) ---
GIN_MODE=release                # release=关 gin 路由日志；开发可留空(debug)
GVA_SYSTEM_ENV=public           # public=图形验证码不回显答案；开发留空(用 yaml 的 local)
GVA_ZAP_LEVEL=warn              # 生产建议 warn
GVA_DISABLE_AUTO_MIGRATE=false  # 生产若要手动迁移表结构改 true
# GVA_DB_TYPE=                  # 非空则覆盖 system.db-type(pgsql|mysql|...)
# GVA_OSS_TYPE=                 # 非空则覆盖 system.oss-type；与下方 OSS AK/SK 自动配套生效
# GVA_ROUTER_PREFIX=            # 路由全局前缀，改动需同步前端三端与 e2e 脚本
# GVA_SSO_MAX_AGE_SEC=300       # SSO 链接时效(秒)，生产建议开启防重放
# GVA_OPEN_CAPTCHA=0            # 0=每次登录都要图形码；>0=错 N 次后出码
# GVA_KAFKA_ENABLED=            # 非空覆盖 kafka.enabled(bool)
# GVA_KAFKA_BROKERS=            # 逗号分隔集群地址，如 kb1:9092,kb2:9092,kb3:9092
